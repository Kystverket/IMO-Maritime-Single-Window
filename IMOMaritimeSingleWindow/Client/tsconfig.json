{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "es2022",
      "dom"
    ],
    "paths": {
      "app/*": ["./src/app/*"],
      "selective-preloading-strategy": ["./src/selective-preloading-strategy.ts"],
      "ng2-smart-table": ["./src/app/shared/smart-table/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
